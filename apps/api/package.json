{
  "name": "@devguard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevGuard API: authoritative policy, devices, events and approvals",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test prisma",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "preseed": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "generate": "prisma generate",
    "pretypecheck": "prisma generate",
    "prebuild": "prisma generate",
    "pretest": "prisma generate"
  },
  "dependencies": {
    "@devguard/policy-engine": "workspace:*",
    "@devguard/shared": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "8.3.0",
    "jose": "^6.2.12",
    "nestjs-pino": "5.3.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@devguard/config": "workspace:*",
    "@nestjs/testing": "12.1.3",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
