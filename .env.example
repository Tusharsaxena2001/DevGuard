# Copy to .env for local development. Placeholders only — never commit real values.

# Postgres (docker-compose maps host port 5433 -> container 5432; 5432 is often taken locally)
POSTGRES_USER=devguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=devguard
POSTGRES_PORT=5433
DATABASE_URL=postgresql://devguard:change-me-local-only@localhost:5433/devguard

# API (apps/api, API-1)
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
JWT_SECRET=replace-with-32+-random-bytes
SESSION_TTL_MINUTES=60
ENROLLMENT_TOKEN_TTL_MINUTES=30
EXCEPTION_MAX_TTL_HOURS=72

# Alerts (available once API-8 lands). Dev defaults point at Mailpit (docker compose up -d mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=devguard@localhost
DASHBOARD_BASE_URL=http://localhost:5173
ALERT_WEBHOOK_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
ALERT_THROTTLE_WINDOW_MINUTES=10

# Dashboard (available once UI-1 lands)
VITE_API_URL=http://localhost:3000

# Agent (available once AG-1 lands)
DEVGUARD_API_URL=http://localhost:3000
DEVGUARD_POLICY_MAX_STALE_MINUTES=60
