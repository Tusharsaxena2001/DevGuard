    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e:demo": "bash scripts/e2e-demo.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "eslint": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
