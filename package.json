{
  "name": "devguard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DevGuard — developer security guardrail for company-managed laptops",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
