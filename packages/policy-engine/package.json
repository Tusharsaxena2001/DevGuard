{
  "name": "@devguard/policy-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure, deterministic policy evaluation for DevGuard (no I/O, no frameworks)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@devguard/shared": "workspace:*"
  },
  "devDependencies": {
    "@devguard/config": "workspace:*"
  }
}
